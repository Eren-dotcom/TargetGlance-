# Optional live-data keys. Copy to .env and export it before `npm run dev`, or set them in
# your shell / host. The app runs without any of these — they buy a documented rate limit,
# a documented symbol list and a diagnosable error, not different prices.
#
# Server-side only. Never commit a real key; never put one in app.json or the bundle.
# TARGETGLANCE_KEY_FINNHUB=        # 60 req/min free
# TARGETGLANCE_KEY_TWELVEDATA=     # 8 req/min free, global incl. NSE/BSE
# TARGETGLANCE_KEY_POLYGON=        # 5 req/min free, US only, delayed
# TARGETGLANCE_PROVIDER=           # finnhub | twelvedata | polygon, when several are set
#
# Telegram alerts (optional): create a bot with @BotFather, set the token here on the
# server, restart, then message the bot once to pair your chat.
# TARGETGLANCE_TG_TOKEN=           # bot token from @BotFather
# TARGETGLANCE_TG_CHAT=            # optional: pre-pair a chat id instead of first-message pairing
