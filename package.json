{
  "name": "targetglance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Buy-zone / sell-zone alerts for stocks + crypto on Even G2. Paper trades, no exchange keys.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "proxy": "node --experimental-strip-types src/server/standalone.ts",
    "test": "vitest run",
    "probe": "node --experimental-strip-types src/server/standalone.ts --probe",
    "pack": "npm run build && evenhub pack app.json dist -o targetglance.ehpk",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
